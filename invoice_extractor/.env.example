# Label Studio Configuration
LABEL_STUDIO_URL=http://127.0.0.1:8080
LABEL_STUDIO_API_KEY=your_label_studio_api_key

# Document Processor Selection
DOCUMENT_PROCESSOR=piaozone  # Options: gemini, openai, piaozone, mock

# Gemini Configuration
API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-preview-04-17
GEMINI_TEMPERATURE=0.1
GEMINI_THINKING_BUDGET=1000  # 需要思考时，设置（优先API参数，其次是这里）

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# PiaoZone Configuration
# Option 1: Static Token (backward compatible)
# PIAOZONE_ACCESS_TOKEN=your_static_access_token

# Option 2: Dynamic Token (recommended)
PIAOZONE_CLIENT_ID=Q3V07mngUYcDOGeELsIS
PIAOZONE_CLIENT_SECRET=your_secret
PIAOZONE_TOKEN_URL=https://api-sit.piaozone.com/base/oauth/token
PIAOZONE_TOKEN_DURATION_HOURS=24

# PiaoZone API Settings
PIAOZONE_API_URL=https://api-sit.piaozone.com/ai/knowledge/v1/chat/completions
PIAOZONE_MODEL=gemini-2.5-flash-preview-04-17
PIAOZONE_TEMPERATURE=0.1
PIAOZONE_MAX_OUTPUT_TOKENS=8192
PIAOZONE_RESPONSE_MIME_TYPE=application/json

# Proxy Configuration (if needed)
USING_PROXY=FALSE
HTTP_PROXY=http://your-proxy:port
HTTPS_PROXY=http://your-proxy:port

# Development Settings
USE_MOCK_DATA=FALSE

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR

MODEL_DIR=/data/models
PORT=9090